# Mediescare environment variables. Copy to `.env` (git-ignored) and fill in. NEVER commit real values.
# Only the variable names and safe examples are listed here. The packaged desktop app sets most of the
# branch variables itself; this file is for development, the CLI tools and the cloud deployment.

# ---------------------------------------------------------------------------------------------
# Branch / single PC (development)
# ---------------------------------------------------------------------------------------------
# single | branch-server | terminal | cloud
MEDIESCARE_MODE=single
# Folder holding the local SQLite database (default ./data)
MEDIESCARE_DATA_DIR=./data
# 64 hex characters, the SQLCipher key. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDIESCARE_DB_KEY=
# At least 32 random characters, signs session cookies.
MEDIESCARE_SESSION_SECRET=
MEDIESCARE_PORT=3210
# Optional: backups folder, migrations folder, demo seed password
MEDIESCARE_BACKUP_DIR=
MEDIESCARE_MIGRATIONS_DIR=
MEDIESCARE_DEMO_PASSWORD=
# 1 switches the background jobs (backup, sync worker) off, used by tests
MEDIESCARE_DISABLE_JOBS=

# ---------------------------------------------------------------------------------------------
# Cloud sync, branch side (how a PC reaches the cloud)
# ---------------------------------------------------------------------------------------------
# Normally you do NOT set these: Settings > Cloud sync > "Connect to cloud" (Head Office) or the branch
# setup screen stores the cloud address and a rotating login in the data folder, encrypted.
# Legacy fixed-token setup, development only:
MEDIESCARE_CLOUD_URL=
MEDIESCARE_CLOUD_TOKEN=
# 1 allows plain http to a non-loopback address (private test networks only)
MEDIESCARE_CLOUD_ALLOW_INSECURE=
# Pause between sync cycles in ms (default 5000, minimum 500) and where a fenced server writes its unsent tail
MEDIESCARE_SYNC_INTERVAL_MS=
MEDIESCARE_SYNC_EXPORT_DIR=

# ---------------------------------------------------------------------------------------------
# Cloud deployment (MEDIESCARE_MODE=cloud, for example on Vercel). See docs/cloud-deploy.md
# ---------------------------------------------------------------------------------------------
# Supabase > Connect > "Session pooler" connection string (host aws-0-<region>.pooler.supabase.com,
# user postgres.<project-ref>, port 5432). NOT the "Direct connection" (IPv6 only on the free plan).
# Example shape: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
MEDIESCARE_CLOUD_DATABASE_URL=
# Random secret (at least 32 characters) that signs device access tokens. Changing it logs every device out
# until it refreshes. Generate with the node command above.
MEDIESCARE_CLOUD_JWT_SECRET=
# Secret typed once on the first Head Office PC ("Connect to cloud"). Choose any long random text.
MEDIESCARE_CLOUD_BOOTSTRAP_CODE=
# postgres (default) | pglite (free in-process PostgreSQL for local development) | memory (tests)
MEDIESCARE_CLOUD_STORE=
# pglite only: folder to keep the data in (empty = in memory, lost on restart)
MEDIESCARE_CLOUD_PGLITE_DIR=
# Override where the cloud SQL files are read from (default: packages/db/cloud)
MEDIESCARE_CLOUD_MIGRATIONS_DIR=
# Build output folder, only to run a second build next to the normal one (default .next)
MEDIESCARE_NEXT_DIST_DIR=
