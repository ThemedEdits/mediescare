# Runtime mode: single | branch-server | terminal | cloud
MEDIESCARE_MODE=single

# Folder for the local SQLite database, backups and logs (defaults to the OS user-data folder in Electron)
MEDIESCARE_DATA_DIR=./data

# 64 hex characters (256-bit). Electron generates and protects this key itself (ADR-0001).
# Only set it by hand for local development and tests. Never commit a real key.
MEDIESCARE_DB_KEY=

# Secret for signing session cookies (jose). Electron generates one per install.
MEDIESCARE_SESSION_SECRET=

# Branch server port (branch-server and single modes)
MEDIESCARE_PORT=3210

# Cloud mode only (Supabase used as plain PostgreSQL, no Supabase Auth: see ADR-0003)
MEDIESCARE_CLOUD_DATABASE_URL=
